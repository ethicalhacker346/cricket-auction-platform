NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_auction

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Set to the exact number of trusted ingress hops (e.g. 1 behind one proxy).
# Leave 0 for a server directly reachable by clients. Never trust all proxies.
TRUST_PROXY_HOPS=0
# Per-minute live traffic budgets, independent of ordinary API requests/bids.
AUCTION_READ_RATE_LIMIT_MAX=1200
AUCTION_GUEST_RATE_LIMIT_MAX=12000
AUCTION_COMMAND_RATE_LIMIT_MAX=180
SOCKET_MAX_CONNECTIONS_PER_IP=2000
# REDIS_URL=redis://127.0.0.1:6379

# Auction Settings
MAX_BID_AMOUNT=50000000
AUCTION_ROOM_MAX_SIZE=500

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug