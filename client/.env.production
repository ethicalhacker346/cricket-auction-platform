# ═══════════════════════════════════════════════════════════════
# GullyBid Frontend — Production Environment
# These are BUILD-TIME variables (embedded at build, not runtime)
# ═══════════════════════════════════════════════════════════════

# API Base URL (your Railway backend)
VITE_API_BASE_URL=https://gullybid-api.up.railway.app/api/v1

# Socket.IO Server URL
VITE_SOCKET_URL=https://gullybid-api.up.railway.app

# App Name
VITE_APP_NAME=GullyBid

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_SENTRY_DSN=

# Build Mode
NODE_ENV=production